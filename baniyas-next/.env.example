# ---------------------------------------------------------------
# Bani Yas website - environment variables
# Copy this file to .env and fill in real values.
# ---------------------------------------------------------------

# Public URL of the site (used for metadata / absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=baniyas
DB_PASSWORD=change_me
DB_NAME=baniyas
# Max pooled connections
DB_CONNECTION_LIMIT=10

# ---------- Admin authentication ----------
# Secret used to sign the admin session JWT. Use a long random string (min 32 chars):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
# Session lifetime in hours
AUTH_SESSION_HOURS=12

# First admin account created by `npm run db:seed` / `npm run admin:create`
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@baniyasbuilders.com
ADMIN_PASSWORD=ChangeMe@123

# ---------- Uploads ----------
# Where admin-uploaded images are stored (outside /public so they work after `next build`)
UPLOAD_DIR=./storage/uploads

# ---------- Contact form ----------
# Messages are always stored in MySQL (Admin > Messages).
# Optionally forward them to an external mail API as JSON {name,email,phone,message}.
CONTACT_FORWARD_URL=https://baymail.baytech.in/api/contact
